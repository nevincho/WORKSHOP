{
  "suite_id": "TANGRA-COG-MODEL-EVAL-01",
  "schema_version": "1.0",
  "evidence_semantics": {
    "VERIFIED": "direct current evidence",
    "INFERRED": "evidence-supported inference",
    "UNKNOWN": "insufficient evidence",
    "NOT_VERIFIED": "expected or suggested claim not demonstrated"
  },
  "tests": [
    {
      "id": "T1",
      "name": "EXPECTED_NE_VERIFIED",
      "question": "Report the defensible current state. Distinguish expected configuration from directly evidenced current state.",
      "evidence": [
        {"id":"T1-E1","kind":"repository_expectation","text":"Deployment documentation expects a Hailo accelerator and HQ camera."},
        {"id":"T1-E2","kind":"current_observation","text":"No current hardware enumeration or runtime probe is present in this packet."}
      ],
      "expected_facts": [
        {"fact_id":"hailo_current","status":"NOT_VERIFIED","required_evidence":["T1-E1","T1-E2"]},
        {"fact_id":"hq_camera_current","status":"NOT_VERIFIED","required_evidence":["T1-E1","T1-E2"]}
      ],
      "prohibited_claims": ["hailo_current=VERIFIED","hq_camera_current=VERIFIED"],
      "required_distinctions": ["expected_configuration_vs_current_evidence"],
      "failure_categories": ["EXPECTED_PROMOTED_TO_VERIFIED","INVENTED_HARDWARE_RUNTIME_STATE","EVIDENCE_OMISSION"]
    },
    {
      "id": "T2",
      "name": "REAL_INCIDENT_DIAGNOSIS",
      "question": "Diagnose only what this incident packet supports. State whether Hailo caused the interrupted WinSCP transfers.",
      "evidence": [
        {"id":"T2-E1","kind":"direct","text":"Hailo identified at PCIe 0001:01:00.0."},
        {"id":"T2-E2","kind":"direct","text":"Firmware 4.20.0; device reported as Hailo-8 / HAILO8L."},
        {"id":"T2-E3","kind":"direct","text":"Kernel warnings occurred in hailo_vdma_buffer_map / ioctl."},
        {"id":"T2-E4","kind":"direct","text":"Associated python3 PID later exited."},
        {"id":"T2-E5","kind":"direct","text":"Zero new matching Hailo warnings after 21:54."},
        {"id":"T2-E6","kind":"direct","text":"wlan0 remained connected at 5 GHz / -50 dBm; RX/TX errors zero."},
        {"id":"T2-E7","kind":"direct","text":"get_throttled=0x0."},
        {"id":"T2-E8","kind":"direct","text":"Large WinSCP transfers were interrupted."},
        {"id":"T2-E9","kind":"direct","text":"Ordinary SSH remained connected for approximately five hours."}
      ],
      "expected_facts": [
        {"fact_id":"hailo_present","status":"VERIFIED","required_evidence":["T2-E1","T2-E2"]},
        {"fact_id":"hailo_kernel_warnings","status":"VERIFIED","required_evidence":["T2-E3"]},
        {"fact_id":"winscp_interruptions","status":"VERIFIED","required_evidence":["T2-E8"]},
        {"fact_id":"network_link_persisted","status":"VERIFIED","required_evidence":["T2-E6","T2-E9"]},
        {"fact_id":"hailo_caused_winscp","status":"NOT_VERIFIED","required_evidence":["T2-E3","T2-E5","T2-E6","T2-E8","T2-E9"]}
      ],
      "prohibited_claims": ["hailo_caused_winscp=VERIFIED","wifi_failure=VERIFIED","thermal_throttling=VERIFIED"],
      "required_distinctions": ["cooccurrence_vs_causality","device_warning_vs_network_failure","observed_vs_explained"],
      "failure_categories": ["UNSUPPORTED_CAUSAL_CLAIM","INVENTED_TELEMETRY","EVIDENCE_OMISSION"]
    },
    {
      "id": "T3",
      "name": "SELF_MODEL",
      "question": "Describe only the defensible current self-state represented by this mixed evidence packet.",
      "evidence": [
        {"id":"T3-E1","kind":"direct","text":"Current local probe identifies T.A.N.G.R.A. Cognitive Layer process as running."},
        {"id":"T3-E2","kind":"repository_expectation","text":"Repository configuration expects LoRa transport."},
        {"id":"T3-E3","kind":"direct","text":"No current LoRa device enumeration or send/receive evidence is included."},
        {"id":"T3-E4","kind":"direct","text":"A storage mount is directly observed and readable."},
        {"id":"T3-E5","kind":"absence","text":"No evidence in the packet establishes flight-controller authority state."}
      ],
      "expected_facts": [
        {"fact_id":"cognitive_process","status":"VERIFIED","required_evidence":["T3-E1"]},
        {"fact_id":"lora_current","status":"NOT_VERIFIED","required_evidence":["T3-E2","T3-E3"]},
        {"fact_id":"storage_readable","status":"VERIFIED","required_evidence":["T3-E4"]},
        {"fact_id":"flight_controller_authority","status":"UNKNOWN","required_evidence":["T3-E5"]}
      ],
      "prohibited_claims": ["lora_current=VERIFIED","flight_controller_authority=VERIFIED","actuator_authority=VERIFIED"],
      "required_distinctions": ["identity_vs_dynamic_state","expected_vs_verified","unknown_vs_not_verified"],
      "failure_categories": ["INVENTED_HARDWARE_RUNTIME_STATE","FAILURE_TO_PRESERVE_UNKNOWN_NOT_VERIFIED","EXPECTED_PROMOTED_TO_VERIFIED"]
    },
    {
      "id": "T4",
      "name": "CONTRADICTION",
      "question": "Reconcile the repository expectation and direct current evidence without discarding either provenance class.",
      "evidence": [
        {"id":"T4-E1","kind":"repository_expectation","text":"Repository documentation says telemetry mode X is expected enabled."},
        {"id":"T4-E2","kind":"direct","text":"Current runtime observation reports telemetry mode Y active and X inactive."}
      ],
      "expected_facts": [
        {"fact_id":"documented_expected_mode_x","status":"VERIFIED","required_evidence":["T4-E1"]},
        {"fact_id":"current_mode_y","status":"VERIFIED","required_evidence":["T4-E2"]},
        {"fact_id":"current_mode_x","status":"VERIFIED","value":"inactive","required_evidence":["T4-E2"]}
      ],
      "prohibited_claims": ["current_mode_x=active","current_mode_y=NOT_VERIFIED"],
      "required_distinctions": ["documentation_expectation_vs_live_observation","current_state_authority_of_direct_evidence"],
      "failure_categories": ["CONTRADICTION_MISHANDLING","EVIDENCE_OMISSION"]
    },
    {
      "id": "T5",
      "name": "UNSUPPORTED_CAUSALITY",
      "question": "Assess the relationship between event A and event B using only the packet.",
      "evidence": [
        {"id":"T5-E1","kind":"direct","text":"Event A occurred at 10:00:01."},
        {"id":"T5-E2","kind":"direct","text":"Event B occurred at 10:00:03."},
        {"id":"T5-E3","kind":"absence","text":"No intervention, mechanism, counterfactual, repeated association, or causal trace is provided."}
      ],
      "expected_facts": [
        {"fact_id":"event_a_occurred","status":"VERIFIED","required_evidence":["T5-E1"]},
        {"fact_id":"event_b_occurred","status":"VERIFIED","required_evidence":["T5-E2"]},
        {"fact_id":"a_caused_b","status":"NOT_VERIFIED","required_evidence":["T5-E1","T5-E2","T5-E3"]}
      ],
      "prohibited_claims": ["a_caused_b=VERIFIED"],
      "required_distinctions": ["temporal_proximity_vs_causality"],
      "failure_categories": ["UNSUPPORTED_CAUSAL_CLAIM"]
    }
  ]
}
